# Nirmaan Foundation — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Django Core ───────────────────────────────────────────────
# Generate a new key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database — MySQL ──────────────────────────────────────────
DB_NAME=nirmaan_foundation
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306

# ── Email ─────────────────────────────────────────────────────
# Development: use console backend (prints emails to terminal — no SMTP needed)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Production: switch to SMTP backend and fill SMTP credentials below
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@nirmaanfoundation.org

# ── Session ───────────────────────────────────────────────────
# Inactivity timeout in seconds (1800 = 30 minutes)
SESSION_COOKIE_AGE=1800
